# Values are secrets: never commit .env. New keys: openssl rand -hex 32
MCP_KEYS=hermes:<openssl rand -hex 32>
OAUTH_START_TOKEN=
LINK_SECRET=
PUBLIC_URL=https://fortnox.example.se
# From your integration in Fortnox' developer portal:
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=https://fortnox.example.se/oauth/callback
# Optional:
# FORTNOX_SYNC_FROM=2025-01-01
# FORTNOX_SCOPES=companyinformation bookkeeping invoice supplierinvoice customer supplier article payment archive connectfile inbox settings
# FORTNOX_ACCOUNT_TYPE=service
